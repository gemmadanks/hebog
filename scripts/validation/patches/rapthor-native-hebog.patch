+def test_blanked_dual_run_reports_unavailable_comparison(tmp_path):
+    sector, inputs = sector_inputs(tmp_path)
+    sector["hebog_dual_run"] = True
+    for directory in (tmp_path, tmp_path / "sector.source-finders" / "hebog"):
+        directory.mkdir(parents=True, exist_ok=True)
+        (directory / "true.fits.mask.fits").write_bytes(b"stale normalized mask")
+    for record in inputs[:2]:
+        with fits.open(record["path"], mode="update") as hdus:
+            hdus[0].data[:] = np.nan
+    result = invoke(tmp_path, sector, inputs, command_profile="off")
+    assert result[6] is None
+    summary = json.loads(Path(result[2]["path"]).read_text())
+    assert summary["source_finding"]["comparison_unavailable"].startswith("blanked:")
+    reference = tmp_path / "sector.source-finders" / "bdsf" / "sector.source_catalog.fits"
+    assert len(Table.read(reference)) == 0
