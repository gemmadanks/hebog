+        zip(("nonpb_image", "pb_image", "skymodel_nonpb", "skymodel_pb"), records, strict=True)
+    )
+    config = ExecutionConfig(task_runner="external_dask", cpus_per_task=2, mem_per_node_gb=4)
+
+    @flow
+    def filter_sector():
+        return image_sector_filter_skymodel_task.submit(
+            sector, prepared, str(tmp_path), execution_config=config
