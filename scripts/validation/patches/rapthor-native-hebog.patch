+@pytest.mark.parametrize("profile", ["continuum", "compact"])
+@pytest.mark.parametrize("background", ["estimated", "zero"])
+def test_hebog_settings_and_native_thread_limit(tmp_path, monkeypatch, profile, background):
+    sector, inputs = sector_inputs(tmp_path)
+    sector.update(hebog_profile=profile, hebog_background=background)
+    original = hebog_filter.find_sector_sources
+    pools = []
+
+    def capture(request, compatibility, executor):
+        pools.extend(threadpool_info())
+        return original(request, compatibility, executor)
+
+    monkeypatch.setattr(hebog_filter, "find_sector_sources", capture)
+    before = threadpool_info()
+    result = invoke(tmp_path, sector, inputs)
+    summary = json.loads(Path(result[2]["path"]).read_text())["source_finding"]
+    assert summary["profile"] == profile
+    assert summary["background"] == background
+    assert pools and all(pool["num_threads"] == 1 for pool in pools)
+    assert [p["num_threads"] for p in threadpool_info()] == [p["num_threads"] for p in before]
+    assert summary["expected_sources"] == 1
+    assert 0 < summary["task_memory_bytes"] < 4e9 - summary["analysis_memory_bytes"]
+
