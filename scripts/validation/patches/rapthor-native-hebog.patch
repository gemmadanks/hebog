+def sector_inputs(directory: Path) -> tuple[dict, list[dict]]:
+    """A small sector with a source at its centre and both input sky models."""
+    directory.mkdir(parents=True, exist_ok=True)
+    yy, xx = np.mgrid[:81, :97]
+    plane = np.random.default_rng(7).normal(0, 1, (81, 97))
+    plane += 40 * np.exp(-((xx - 48) ** 2 + (yy - 40) ** 2) / 4)
+    header = fits.Header(
+        {
+            "BUNIT": "Jy/beam",
+            "BMAJ": 4 / 3600,
+            "BMIN": 4 / 3600,
+            "BPA": 0,
+            "CTYPE1": "RA---SIN",
+            "CTYPE2": "DEC--SIN",
+            "RADESYS": "ICRS",
+            "CRPIX1": 49.0,
+            "CRPIX2": 41.0,
+            "CRVAL1": 180.0,
+            "CRVAL2": 45.0,
+            "CDELT1": -1 / 3600,
+            "CDELT2": 1 / 3600,
+            "RESTFRQ": 144e6,
+            "CTYPE3": "FREQ",
+            "CRPIX3": 1.0,
+            "CRVAL3": 144e6,
+            "CDELT3": 1e6,
+            "CUNIT3": "Hz",
+            "CTYPE4": "STOKES",
+            "CRPIX4": 1.0,
+            "CRVAL4": 1.0,
+            "CDELT4": 1.0,
+        }
+    )
+    paths = [directory / name for name in ("flat.fits", "true.fits", "apparent.txt", "true.txt")]
+    for path in paths[:2]:
+        fits.writeto(path, plane.astype("float32")[None, None], header, overwrite=True)
+    for path in paths[2:]:
+        path.write_text("FORMAT = Name, Type, Ra, Dec, I\ncentre, POINT, 180, 45, 1\n")
+    vertices = directory / "vertices.npy"
+    np.save(vertices, np.array([[179.9, 44.9], [180.1, 44.9], [180.1, 45.1], [179.9, 45.1]]))
+    sector = {
+        "save_source_list": True,
+        "obs_original_paths": [],
+        "threshisl": 3.0,
+        "threshpix": 5.0,
+        "filter_by_mask": True,
+        "source_finder": "hebog",
+        "max_threads": 2,
+        "filter_skymodel_ncores": 2,
+        "vertices_file": str(vertices),
+    }
+    return sector, [file_record(p) for p in paths]
+
+
+def test_hebog_filter_runs_in_process_and_returns_rapthor_products(tmp_path, monkeypatch):
+    """A Hebog sector uses the adapter and LSMTool without a Python subprocess."""
+    sector, inputs = sector_inputs(tmp_path)
+
+    def unexpected_subprocess(*args, **kwargs):
+        raise AssertionError("Hebog must run inside the Prefect task")
+
+    monkeypatch.setattr(outputs, "run_external_command", unexpected_subprocess)
+    result = outputs.filter_skymodel_products(
+        sector,
+        "sector",
+        *inputs,
+        str(tmp_path),
+        execution_config=ExecutionConfig(task_runner="sync", cpus_per_task=2, mem_per_node_gb=4),
+    )
+    assert len(result) == 7
+    assert all(Path(record["path"]).is_file() for record in result)
+    assert len(Table.read(result[5]["path"])) == 1
+    assert "centre" in Path(result[0]["path"]).read_text()
+    diagnostics = json.loads(Path(result[2]["path"]).read_text())
+    assert diagnostics["nsources"] == 1
+    assert diagnostics["source_finding"]["selected"] == "hebog"
+    assert diagnostics["source_finding"]["analysis_memory_bytes"] > 0
+
+
+def invoke(directory, sector, inputs, *, mem_per_node_gb=4, **config_options):
+    return outputs.filter_skymodel_products(
+        sector,
+        "sector",
+        *inputs,
+        str(directory),
+        execution_config=ExecutionConfig(
+            task_runner="sync", cpus_per_task=2, mem_per_node_gb=mem_per_node_gb, **config_options
+        ),
+    )
+
+
+def native_inputs(directory, records):
+    flat, true, apparent, model = (Path(record["path"]) for record in records)
+    return FilterInputs(
+        flat, true, model, apparent, directory / "sector", directory / "vertices.npy", []
+    )
+
