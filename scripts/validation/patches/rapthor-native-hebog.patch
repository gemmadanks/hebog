+    def without_measurement_set(mask, vertices, true, apparent, bright, beam, *args):
+        assert beam == ["beam.ms"]
+        return original(mask, vertices, true, apparent, bright, [], *args)
+
+    monkeypatch.setattr(hebog_filter, "filter_sources", without_measurement_set)
+    result = invoke(tmp_path, sector, inputs)
+    ratio = np.nanmedian(fits.getdata(result[4]["path"]) / fits.getdata(result[3]["path"]))
+    assert ratio == pytest.approx(5, rel=1e-6)
+
+
+def test_typed_refusal_runs_the_real_pybdsf_subprocess(tmp_path, monkeypatch):
+    sector, inputs = sector_inputs(tmp_path)
+
+    def refuse(*args, **kwargs):
+        raise SourceFinderImageTooLargeError("outside the Hebog envelope")
+
+    monkeypatch.setattr(hebog_filter, "find_sector_sources", refuse)
+    result = invoke(tmp_path, sector, inputs, command_profile="off")
+    summary = json.loads(Path(result[2]["path"]).read_text())
+    assert summary["source_finding"]["selected"] == "bdsf"
+    assert summary["nsources"] == 1
+    assert all(Path(record["path"]).is_file() for record in result)
+    assert not (tmp_path / "sector.hebog").exists()
+
+
+@pytest.mark.parametrize(
+    "threads,memory,configured,error,match",
+    [
+        (2, 4e9, 4, ValueError, "one task thread"),
+        (1, 0, 0, ValueError, "finite worker"),
+        (1, 1, 0, ExecutorAdmissionError, "No memory remains"),
+    ],
+)
+def test_invalid_worker_admission_fails(threads, memory, configured, error, match, monkeypatch):
+    """A misconfigured worker fails; one too small for the analysis is a typed refusal."""
+    from types import SimpleNamespace
+
+    worker = SimpleNamespace(
+        state=SimpleNamespace(nthreads=threads), memory_manager=SimpleNamespace(memory_limit=memory)
+    )
+    monkeypatch.setattr(hebog_filter, "get_worker", lambda: worker)
+    with pytest.raises(ValueError, match=match) as raised:
+        hebog_filter._thread_budget(ExecutionConfig(mem_per_node_gb=configured), 2, 1)
+    assert (raised.type is ExecutorAdmissionError) == (error is ExecutorAdmissionError)
+
+
+def test_configured_dask_task_must_really_run_on_a_worker():
+    with pytest.raises(RuntimeError, match="Rapthor's Dask worker"):
+        hebog_filter._thread_budget(ExecutionConfig(task_runner="external_dask"), 2, 1)
+
+
+def test_worker_memory_budget_reserves_analysis_and_resident_process(monkeypatch):
+    from types import SimpleNamespace
+
+    worker = SimpleNamespace(
+        state=SimpleNamespace(nthreads=1),
+        memory_manager=SimpleNamespace(memory_limit=3_000_000_000),
+    )
+    monkeypatch.setattr(hebog_filter, "get_worker", lambda: worker)
+    monkeypatch.setattr(
+        hebog_filter.psutil,
+        "Process",
+        lambda: SimpleNamespace(memory_info=lambda: SimpleNamespace(rss=100_000_000)),
+    )
+    assert (
+        hebog_filter._thread_budget(ExecutionConfig(mem_per_node_gb=4), 2, 200_000_000)
+        == 2_700_000_000
+    )
+
+
+def test_sync_memory_budget_respects_container_limit(monkeypatch):
+    from types import SimpleNamespace
+
+    import distributed.system
+
+    monkeypatch.setattr(distributed.system, "memory_limit", lambda: 500_000_000)
+    monkeypatch.setattr(
+        hebog_filter.psutil, "virtual_memory", lambda: SimpleNamespace(available=8_000_000_000)
+    )
+    monkeypatch.setattr(
+        hebog_filter.psutil,
+        "Process",
+        lambda: SimpleNamespace(memory_info=lambda: SimpleNamespace(rss=100_000_000)),
+    )
+    config = ExecutionConfig(task_runner="sync", mem_per_node_gb=4)
+    assert hebog_filter._thread_budget(config, 2, 200_000_000) == 200_000_000
+
