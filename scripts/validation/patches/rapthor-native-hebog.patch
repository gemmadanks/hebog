+def test_dual_run_retains_separate_products_and_selects_hebog(tmp_path):
+    """Exercise the actual PyBDSF subprocess as well as the in-process path."""
+    import hashlib
+
+    sector, inputs = sector_inputs(tmp_path)
+    sector["hebog_dual_run"] = True
+    result = invoke(tmp_path, sector, inputs, command_profile="off")
+    summary = json.loads(Path(result[2]["path"]).read_text())
+    comparison = summary["source_finding"]["comparison"]
+    assert summary["source_finding"]["selected"] == "hebog"
+    assert comparison["matched_source_count"] == 1
+    for finder in ("hebog", "pybdsf"):
+        for kind in ("source_catalog", "true_sky_rms", "flat_noise_rms", "mask"):
+            identity = comparison[finder][kind]
+            product = Path(identity["path"])
+            assert product.is_file()
+            assert hashlib.sha256(product.read_bytes()).hexdigest() == identity["sha256"]
+    assert (
+        Path(result[5]["path"]).read_bytes()
+        == Path(comparison["hebog"]["source_catalog"]["path"]).read_bytes()
+    )
+    assert comparison["hebog"]["mask"]["path"] != comparison["pybdsf"]["mask"]["path"]
