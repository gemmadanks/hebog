+def test_retry_reuses_bundle_and_replaces_lsmtool_modified_mask(tmp_path):
+    sector, inputs = sector_inputs(tmp_path)
+    result = invoke(tmp_path, sector, inputs)
+    catalogue = tmp_path / "sector.hebog" / "catalogue.fits"
+    modified = catalogue.stat().st_mtime_ns
+    original_mask = Path(result[6]["path"]).read_bytes()
+    Path(result[6]["path"]).write_bytes(b"clipped or interrupted earlier filtering")
+    retried = invoke(tmp_path, sector, inputs)
+    assert catalogue.stat().st_mtime_ns == modified
+    assert Path(retried[6]["path"]).read_bytes() == original_mask
+    assert result == retried
