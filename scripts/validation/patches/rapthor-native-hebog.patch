+
+    def run_reference(root: Path) -> None:
+        # PyBDSF writes its mask beside the filename passed to process_image,
+        # even when cwd differs. Private input links keep reference products
+        # away from both original inputs and the Hebog product set.
+        flat_path, true_path = nonpb_image["path"], pb_image["path"]
+        if source_finder == "hebog":
+            links = root.parent / f".{root.name}.bdsf-inputs"
+            links.mkdir(parents=True, exist_ok=True)
+            for name, source in (("flat.fits", flat_path), ("true.fits", true_path)):
+                link = links / name
+                Path(f"{link}.mask.fits").unlink(missing_ok=True)
+                if link.is_symlink():
+                    link.unlink()
+                link.symlink_to(Path(source).resolve())
+            flat_path, true_path = str(links / "flat.fits"), str(links / "true.fits")
+        run_external_command(
+            build_filter_skymodel_command(
+                flat_path,
+                true_path,
+                true_sky_skymodel,
+                apparent_sky_skymodel,
+                str(root),
+                str(sector["vertices_file"]),
+                beam_ms,
+                threshisl,
+                threshpix,
+                filter_by_mask,
+                "bdsf" if source_finder == "hebog" else source_finder,
+                ncores,
+                bright_true_sky_skymodel=bright_true_sky_skymodel,
+            ),
+            str(root.parent),
+            config,
+            name="filter_skymodel",
+            environment={**temporary_environment("/tmp"), **filter_skymodel_environment()},
+            shell_operation_cls=shell_operation_cls,
+        )
+
+        if source_finder == "hebog":
+            mask = Path(f"{true_path if beam_ms else flat_path}.mask.fits")
+            target = root.parent / f"{Path(pb_image['path']).name}.mask.fits"
+            if mask.is_file():
+                mask.replace(target)
+            else:
+                target.unlink(missing_ok=True)
+
+    if source_finder == "hebog":
+        # Optional dependency: the default PyBDSF path imports no Hebog objects.
+        from hebog.adapters import RapthorCompatibilityConfig
+
