+@pytest.mark.parametrize("value", [np.nan, 0.0])
+def test_blanked_sector_keeps_existing_empty_contract(tmp_path, monkeypatch, value):
+    sector, inputs = sector_inputs(tmp_path)
+    (tmp_path / "true.fits.mask.fits").write_bytes(b"stale normalized mask")
+    for image in inputs[:2]:
+        with fits.open(image["path"], mode="update") as hdus:
+            hdus[0].data[:] = value
+
+    def unexpected(*args, **kwargs):
+        pytest.fail("Blank images must not fall back")
+
+    monkeypatch.setattr(outputs, "run_external_command", unexpected)
+    result = invoke(tmp_path, sector, inputs)
+    assert result[6] is None
+    summary = json.loads(Path(result[2]["path"]).read_text())
+    assert summary["nsources"] == 0
+    assert summary["source_finding"]["status"] == "blanked"
+    assert Path(result[0]["path"]).read_text().count("\n") == 1
+    np.testing.assert_equal(fits.getdata(result[3]["path"]), fits.getdata(inputs[0]["path"]))
