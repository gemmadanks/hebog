diff --git a/rapthor/execution/image/hebog_filter.py b/rapthor/execution/image/hebog_filter.py
new file mode 100644
index 00000000..6bb6fc52
--- /dev/null
+++ b/rapthor/execution/image/hebog_filter.py
@@ -0,0 +1,288 @@
+"""Optional native source finding on Rapthor's one-task-per-worker layout.
+
+Rapthor owns the thread pool and reserves the analysis memory, sized from the
+image's estimated source count, before admitting Hebog's tile tasks. A worker
+too small for them runs PyBDSF instead. The scientific package knows no
+Prefect or LSMTool objects.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import shutil
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, replace
+from pathlib import Path
+from uuid import NAMESPACE_URL, uuid5
+
+import psutil
+from astropy.io import fits
+from astropy.wcs import WCS
+from distributed import get_worker, system
+from hebog import SourceFinderError, analysis_memory_bytes, expected_source_count
+from hebog.adapters import (
+    RapthorBlankedImageError,
+    RapthorCompatibilityConfig,
+    RapthorSourceFindingRequest,
+    RapthorSourceFindingResult,
+    find_sector_sources,
+)
+from hebog.adapters.rapthor_comparison import RapthorSectorProducts, compare_sector_products
+from hebog.executors import ExecutorAdmissionError, ThreadExecutor
+from lsmtool.filter_skymodel.bdsf import create_dummy_skymodel, filter_sources
+from threadpoolctl import threadpool_limits
+
+from rapthor.execution.config import ExecutionConfig
+from rapthor.execution.image.skymodel_filter import _write_blank_filter_outputs
+
+logger = logging.getLogger("rapthor:image")
+
+
+@dataclass(frozen=True)
+class FilterInputs:
+    """Paths used locally by the finder and LSMTool, never sent as open objects."""
+
+    flat_noise_image: Path
+    true_sky_image: Path
+    true_sky_skymodel: Path | None
+    apparent_sky_skymodel: Path | None
+    output_root: Path
+    vertices_file: Path
+    beam_ms: Sequence[str]
+    bright_true_sky_skymodel: Path | None = None
+
+    @property
+    def detection_image(self) -> Path:
+        """Match LSMTool's no-beam branch, where the flat image supplies both RMS maps."""
+        return self.true_sky_image if self.beam_ms else self.flat_noise_image
+
+
+@dataclass(frozen=True)
+class _DummyImagePosition:
+    """The two attributes LSMTool's PyBDSF dummy writer consumes, in x/y order."""
+
+    shape: tuple[int, int]
+    wcs: WCS
+
+    def pix2sky(self, pixel: tuple[float, float]) -> tuple[float, float]:
+        """Convert PyBDSF's zero-origin centre pixel to celestial degrees."""
+        ra, dec = self.wcs.all_pix2world([pixel], 0)[0]
+        return float(ra), float(dec)
+
+
+def _require_sky_models(inputs: FilterInputs) -> None:
+    """Fail on a missing sky model before Hebog runs, not after."""
+    for path in (inputs.true_sky_skymodel, inputs.bright_true_sky_skymodel):
+        if path is not None and not path.is_file():
+            raise FileNotFoundError(path)
+
+
+def _thread_budget(config: ExecutionConfig, ncores: int, reserved_bytes: int) -> int:
+    """Return the memory left for tasks in the single occupied worker process."""
+    if ncores < 1 or (config.cpus_per_task and ncores > config.cpus_per_task):
+        raise ValueError("Hebog's filter_skymodel_ncores must fit cpus_per_task")
+    limits = [config.mem_per_node_gb * 10**9] if config.mem_per_node_gb else []
+    try:
+        worker = get_worker()
+    except ValueError:
+        if config.task_runner != "sync":
+            raise RuntimeError("The native Hebog task must run on Rapthor's Dask worker") from None
+        limits.extend((psutil.virtual_memory().available, system.memory_limit()))
+    else:
+        if worker.state.nthreads != 1:
+            raise ValueError("Native Hebog currently requires one task thread per Dask worker")
+        if worker.memory_manager.memory_limit:
+            limits.append(worker.memory_manager.memory_limit)
+    if not limits:
+        raise ValueError("Native Hebog requires a finite worker or mem_per_node_gb memory budget")
+    # Existing Rapthor/LSMTool objects stay resident while Hebog runs. Their RSS
+    # is additional to the analysis estimate and the tile-task declarations.
+    remaining = min(limits) - reserved_bytes - psutil.Process().memory_info().rss
+    if remaining <= 0:
+        raise ExecutorAdmissionError(
+            "No memory remains for Hebog tasks after reserving the analysis"
+        )
+    return remaining
+
+
+def _filter_products(
+    inputs: FilterInputs, result: RapthorSourceFindingResult, filter_by_mask: bool
+) -> None:
+    """Apply the same island/no-model branch as pinned LSMTool's bdsf backend."""
+    if result.island_count and (inputs.true_sky_skymodel or inputs.bright_true_sky_skymodel):
+        filter_sources(
+            str(result.mask_path),
+            str(inputs.vertices_file),
+            None if inputs.true_sky_skymodel is None else str(inputs.true_sky_skymodel),
+            None if inputs.apparent_sky_skymodel is None else str(inputs.apparent_sky_skymodel),
+            None
+            if inputs.bright_true_sky_skymodel is None
+            else str(inputs.bright_true_sky_skymodel),
+            list(inputs.beam_ms),
+            filter_by_mask,
+            True,
+            f"{inputs.output_root}.true_sky.txt",
+            f"{inputs.output_root}.apparent_sky.txt",
+        )
+    else:
+        header = fits.getheader(inputs.detection_image)
+        centre = _DummyImagePosition((header["NAXIS1"], header["NAXIS2"]), WCS(header).celestial)
+        create_dummy_skymodel(
+            centre, f"{inputs.output_root}.true_sky.txt", f"{inputs.output_root}.apparent_sky.txt"
+        )
+
+
+def _native_filter(
+    inputs: FilterInputs,
+    config: ExecutionConfig,
+    compatibility: RapthorCompatibilityConfig,
+    ncores: int,
+    filter_by_mask: bool,
+) -> tuple[RapthorSourceFindingResult, dict]:
+    header = fits.getheader(inputs.detection_image)
+    _require_sky_models(inputs)
+    # The image's peaks bound what Hebog publishes; peeled bright sources
+    # are already subtracted from it and hold no analysis memory.
+    expected_sources = expected_source_count(
+        inputs.detection_image, detection_threshold_sigma=compatibility.threshpix
+    )
+    reserved = analysis_memory_bytes(
+        (header["NAXIS2"], header["NAXIS1"]),
+        expected_sources=expected_sources,
+    )
+    task_memory = _thread_budget(config, ncores, reserved)
+    request = RapthorSourceFindingRequest(
+        true_sky_image_path=inputs.detection_image,
+        flat_noise_image_path=inputs.flat_noise_image,
+        output_root=inputs.output_root,
+        run_id=uuid5(NAMESPACE_URL, inputs.output_root.resolve().as_uri()).hex,
+    )
+    # Safe on the supported layout: this Prefect task occupies the worker's
+    # only task slot. Restore the process-wide native limits on every exit.
+    with (
+        threadpool_limits(limits=1),
+        ThreadExecutor(
+            thread_count=ncores,
+            memory_bytes_per_worker=task_memory,
+        ) as executor,
+    ):
+        result = find_sector_sources(request, compatibility, executor)
+        _filter_products(inputs, result, filter_by_mask)
+    target_mask = RapthorSectorProducts.named(inputs.output_root, inputs.true_sky_image).mask_path
+    if result.mask_path != target_mask:
+        result.mask_path.replace(target_mask)
+        result = replace(result, mask_path=target_mask)
+    return result, {
+        "selected": "hebog",
+        "executor": "threads",
+        "cores": ncores,
+        "expected_sources": expected_sources,
+        "analysis_memory_bytes": reserved,
+        "task_memory_bytes": task_memory,
+        "profile": compatibility.profile,
+        "background": compatibility.background,
+    }
+
+
+def _diagnostics(root: Path, nsources: int, source_finding: dict) -> None:
+    """Publish finder identity within the diagnostics Rapthor already retains."""
+    path = Path(f"{root}.image_diagnostics.json")
+    path.write_text(
+        json.dumps({"nsources": nsources, "source_finding": source_finding}), encoding="utf-8"
+    )
+
+
+def _select_products(source: FilterInputs, target: FilterInputs) -> None:
+    """Copy the selected set; the dual-run originals and Hebog bundle stay intact."""
+    for old, new in zip(
+        RapthorSectorProducts.named(source.output_root, source.true_sky_image).paths(),
+        RapthorSectorProducts.named(target.output_root, target.true_sky_image).paths(),
+        strict=True,
+    ):
+        if old.is_file():
+            shutil.copyfile(old, new)
+        else:
+            new.unlink(missing_ok=True)
+    for suffix in (".true_sky.txt", ".apparent_sky.txt", ".image_diagnostics.json"):
+        shutil.copyfile(f"{source.output_root}{suffix}", f"{target.output_root}{suffix}")
+
+
+def run_hebog_filter(
+    inputs: FilterInputs,
+    config: ExecutionConfig,
+    *,
+    compatibility: RapthorCompatibilityConfig,
+    ncores: int,
+    filter_by_mask: bool,
+    dual_run: bool,
+    run_reference: Callable[[Path], None],
+) -> None:
+    """Run in-process, falling back only on Hebog's typed refusals.
+
+    A refusal is an image or setting Hebog does not support, or a memory budget
+    that cannot admit the analysis or one of its tasks: PyBDSF then runs as it
+    would without Hebog. Blank images use Rapthor's existing empty products.
+    Import, worker-configuration, missing-file, cancellation and unexpected
+    failures propagate to Prefect. Dual runs select Hebog, compare the two
+    *filtered* masks, and retain both complete sets under
+    ``<root>.source-finders/``. The comparison lives in the ordinary image
+    diagnostics and is not an automatic science decision.
+    """
+    if not isinstance(dual_run, bool):
+        raise ValueError("hebog_dual_run must be a boolean")
+    original = inputs
+    if dual_run:
+        directory = inputs.output_root.parent / f"{inputs.output_root.name}.source-finders"
+        inputs = replace(inputs, output_root=directory / "hebog" / inputs.output_root.name)
+    inputs.output_root.parent.mkdir(parents=True, exist_ok=True)
+    # Without a beam the adapter cleans the flat-image mask; Rapthor's
+    # normalized true-image mask must also disappear on a blank retry.
+    RapthorSectorProducts.named(inputs.output_root, inputs.true_sky_image).mask_path.unlink(
+        missing_ok=True
+    )
+    try:
+        result, details = _native_filter(inputs, config, compatibility, ncores, filter_by_mask)
+    except RapthorBlankedImageError:
+        _write_blank_filter_outputs(
+            str(inputs.flat_noise_image),
+            str(inputs.true_sky_image),
+            None if inputs.true_sky_skymodel is None else str(inputs.true_sky_skymodel),
+            None if inputs.apparent_sky_skymodel is None else str(inputs.apparent_sky_skymodel),
+            str(inputs.output_root),
+        )
+        details = {"selected": "hebog", "status": "blanked"}
+        if dual_run:
+            reference_root = inputs.output_root.parent.parent / "bdsf" / inputs.output_root.name
+            reference_root.parent.mkdir(parents=True, exist_ok=True)
+            run_reference(reference_root)
+            details["comparison_unavailable"] = "blanked: no Hebog mask or measurable RMS"
+        _diagnostics(inputs.output_root, 0, details)
+    except (SourceFinderError, ExecutorAdmissionError) as error:
+        logger.warning("Hebog refused the sector; falling back to PyBDSF: %s", error)
+        run_reference(original.output_root)
+        path = Path(f"{original.output_root}.image_diagnostics.json")
+        summary = json.loads(path.read_text())
+        _diagnostics(
+            original.output_root,
+            summary["nsources"],
+            {
+                "selected": "bdsf",
+                "fallback_reason": f"{type(error).__name__}: {error}",
+            },
+        )
+        return
+    else:
+        if dual_run:
+            reference_root = inputs.output_root.parent.parent / "bdsf" / inputs.output_root.name
+            reference_root.parent.mkdir(parents=True, exist_ok=True)
+            run_reference(reference_root)
+            report = compare_sector_products(
+                result,
+                RapthorSectorProducts.named(reference_root, inputs.true_sky_image),
+                Path(f"{inputs.output_root}.image_diagnostics.json"),
+            )
+            details["comparison"] = report.model_dump(mode="json")
+        _diagnostics(inputs.output_root, result.source_count, details)
+    if dual_run:
+        _select_products(inputs, original)
