+pytest.importorskip("hebog", reason="native source finder requires rapthor[hebog]")
+from hebog import SourceFinderImageTooLargeError, expected_source_count
+from hebog.adapters import RapthorCompatibilityConfig
+from hebog.executors import ExecutorAdmissionError
+from threadpoolctl import threadpool_info
