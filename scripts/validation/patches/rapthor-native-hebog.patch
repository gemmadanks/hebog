+@pytest.mark.parametrize(
+    "error",
+    [
+        SourceFinderImageTooLargeError("too wide"),
+        ExecutorAdmissionError("too wide for the admitted memory"),
+        RuntimeError("bug"),
+        ValueError("bug"),
+    ],
+)
+def test_only_typed_hebog_refusals_use_the_reference(tmp_path, monkeypatch, error):
+    _, records = sector_inputs(tmp_path)
+    inputs = native_inputs(tmp_path, records)
+    called = []
+
+    def refuse(*args, **kwargs):
+        raise error
+
+    def reference(root):
+        called.append(root)
+        Path(f"{root}.image_diagnostics.json").write_text('{"nsources": 3}')
+
+    monkeypatch.setattr(hebog_filter, "find_sector_sources", refuse)
+    arguments = dict(
+        compatibility=RapthorCompatibilityConfig(5, 3),
+        ncores=2,
+        filter_by_mask=True,
+        dual_run=True,
+        run_reference=reference,
+    )
+    config = ExecutionConfig(task_runner="sync", cpus_per_task=2, mem_per_node_gb=4)
+    if isinstance(error, (SourceFinderImageTooLargeError, ExecutorAdmissionError)):
+        run_hebog_filter(inputs, config, **arguments)
+        assert called == [inputs.output_root]
+        summary = json.loads(Path(f"{inputs.output_root}.image_diagnostics.json").read_text())
+        assert summary["nsources"] == 3
+        assert summary["source_finding"]["selected"] == "bdsf"
+        assert "too wide" in summary["source_finding"]["fallback_reason"]
+    else:
+        with pytest.raises(type(error), match="bug"):
+            run_hebog_filter(inputs, config, **arguments)
+        assert not called
+
