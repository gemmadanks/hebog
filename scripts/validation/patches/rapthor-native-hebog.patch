+def test_hebog_defaults_to_compact_with_zero_background(tmp_path):
+    """Hebog's agreement with PyBDSF's sky-model filtering chose these (Hebog plan task 21)."""
+    sector, inputs = sector_inputs(tmp_path)
+    for setting in ("hebog_profile", "hebog_background"):
+        sector.pop(setting, None)
+    result = invoke(tmp_path, sector, inputs)
+    summary = json.loads(Path(result[2]["path"]).read_text())["source_finding"]
+    assert (summary["profile"], summary["background"]) == ("compact", "zero")
+
