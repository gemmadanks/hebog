# Build the pinned LSMTool base first, following ../lsmtool/README.md.
# rapthor.tar is the reviewed patched commit; hebog-*.whl is an exact local
# build. Archive identities and this image ID belong in the run's evidence.
FROM localhost/hebog-lsmtool:9bac2f7
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
COPY requirements-build.txt requirements.txt /tmp/
RUN uv pip install --python /opt/lsmtool/bin/python --require-hashes -r /tmp/requirements-build.txt \
    && uv pip install --python /opt/lsmtool/bin/python --require-hashes --no-build-isolation -r /tmp/requirements.txt
ARG RAPTHOR_REVISION
COPY rapthor.tar /tmp/rapthor.tar
RUN test -n "$RAPTHOR_REVISION" \
    && mkdir /opt/rapthor-source \
    && tar -xf /tmp/rapthor.tar -C /opt/rapthor-source \
    && SETUPTOOLS_SCM_PRETEND_VERSION_FOR_RAPTHOR="2.2.0.dev0+g${RAPTHOR_REVISION}" \
       uv pip install --python /opt/lsmtool/bin/python --no-deps --no-build-isolation /opt/rapthor-source
COPY hebog-*.whl /tmp/
RUN uv pip install --python /opt/lsmtool/bin/python --no-deps /tmp/hebog-*.whl \
    && python -m pip check
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 BLIS_NUM_THREADS=1
WORKDIR /work
LABEL org.hebog.purpose="rapthor-native-integration" \
      org.hebog.rapthor-revision="${RAPTHOR_REVISION}" \
      org.hebog.lsmtool-revision="9bac2f7fabdc15cd9490acfeb9c292aa72af59b7"
